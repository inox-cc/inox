static void* inox_default_realloc(void* user, void* ptr, size_t old_size, size_t new_size, size_t align) {
  (void)user;
  (void)old_size;
  (void)align;
  return realloc(ptr, new_size);
}

static void inox_default_free(void* user, void* ptr, size_t size, size_t align) {
