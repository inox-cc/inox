{
  "name": "ccjs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "ccjs": "./bin/ccjs.ts"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:fixtures": "node scripts/test-fixtures.ts",
    "test:capabilities": "node scripts/test-capabilities.ts",
    "test:hir-snapshots": "node scripts/test-hir-snapshots.ts",
    "test:ir-snapshots": "node scripts/test-ir-snapshots.ts",
    "test:codegen-snapshots": "node scripts/test-codegen-snapshots.ts",
    "test:diagnostic-snapshots": "node scripts/test-diagnostic-snapshots.ts",
    "test:snapshots": "npm run test:hir-snapshots && npm run test:ir-snapshots && npm run test:codegen-snapshots && npm run test:diagnostic-snapshots",
    "test:differential": "node scripts/test-differential.ts",
    "check": "npm run build && npm run typecheck && npm test && npm run test:fixtures && npm run test:capabilities && npm run test:snapshots && npm run test:differential"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3"
  }
}
