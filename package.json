{
  "name": "ccjs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.5.1",
  "bin": {
    "ccjs": "./bin/ccjs.ts"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "example": "cmake --build example/build && ./example/build/ccjs_cmake_example",
    "lint": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:examples": "node scripts/test-examples.ts",
    "test:fixtures": "node scripts/test-fixtures.ts",
    "test:capabilities": "node scripts/test-capabilities.ts",
    "test:hir-snapshots": "node scripts/test-hir-snapshots.ts",
    "test:ir-snapshots": "node scripts/test-ir-snapshots.ts",
    "test:codegen-snapshots": "node scripts/test-codegen-snapshots.ts",
    "test:diagnostic-snapshots": "node scripts/test-diagnostic-snapshots.ts",
    "test:snapshots": "pnpm run test:hir-snapshots && pnpm run test:ir-snapshots && pnpm run test:codegen-snapshots && pnpm run test:diagnostic-snapshots",
    "test:differential": "node scripts/test-differential.ts",
    "check": "pnpm run build && pnpm run typecheck && pnpm test && pnpm run test:fixtures && pnpm run test:examples && pnpm run test:capabilities && pnpm run test:snapshots && pnpm run test:differential"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3"
  }
}
