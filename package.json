{
  "name": "inox",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "inox": "./compiler/index.ts"
  },
  "scripts": {
    "build": "node --max-old-space-size=6144 --expose-gc scripts/build.ts",
    "example:simple": "node compiler/index.ts run examples/simple/index.ts",
    "example:simple:inox": "./dist/inox run examples/simple/index.ts",
    "example:http-server": "node compiler/index.ts run examples/http-server/index.ts -- 8080 manual examples/http-server/public",
    "example:http-server:inox": "./dist/inox run examples/http-server/index.ts -- 8080 manual examples/http-server/public",
    "test:example:http-server": "node scripts/check-http-server-example.ts",
    "test:example:http-server:inox": "node scripts/check-http-server-example.ts native",
    "generate:compiler-libraries": "node scripts/generate-compiler-library-registry.ts",
    "boringssl:bootstrap": "node scripts/bootstrap-boringssl.ts",
    "libuv:bootstrap": "node scripts/bootstrap-libuv.ts",
    "clean": "node scripts/clean.ts",
    "lint": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:features",
    "test:architecture": "node scripts/test-log.ts dist/test-architecture.log -- node --test tests/architecture/*.test.ts",
    "test:node": "pnpm run test:features --compiler node",
    "test:inox": "node scripts/test-log.ts dist/test-inox.log -- node scripts/test-inox.ts --compiler dist/inox --semantic-probe dist/inox-stage6-semantic-probe",
    "test:network:inox": "node scripts/test-log.ts dist/test-network-inox.log -- node scripts/check-network-inox.ts",
    "test:features": "node scripts/test-log.ts dist/test.log -- node tests/all.test.ts",
    "test:smoke": "node scripts/test-log.ts dist/test.log -- node tests/all.test.ts tests/smoke",
    "check": "pnpm run typecheck && pnpm run test:architecture && pnpm run test:features"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
