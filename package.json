{
  "name": "inox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.5.1",
  "bin": {
    "inox": "./bin/cli.ts"
  },
  "scripts": {
    "example": "pnpm run example:prepare && cmake --build example/build && ./example/build/inox_cmake_example",
    "example:libuv": "pnpm run example:prepare-libuv && cmake --build example/build-libuv && ./example/build-libuv/inox_cmake_example",
    "example:libuv-boringssl": "pnpm run example:prepare-libuv-boringssl && cmake --build example/build-libuv-boringssl && ./example/build-libuv-boringssl/inox_cmake_example",
    "example:prepare": "cmake -S example -B example/build",
    "example:prepare-libuv": "pnpm run libuv:bootstrap && cmake -S example -B example/build-libuv -DINOX_LOOP_BACKEND=libuv",
    "example:prepare-libuv-boringssl": "pnpm run libuv:bootstrap && pnpm run boringssl:bootstrap && cmake -S example -B example/build-libuv-boringssl -DINOX_LOOP_BACKEND=libuv -DINOX_TLS_BACKEND=boringssl",
    "boringssl:bootstrap": "node scripts/bootstrap-boringssl.ts",
    "libuv:bootstrap": "node scripts/bootstrap-libuv.ts",
    "build": "node scripts/build.ts",
    "clean": "node scripts/clean.ts",
    "audit:self-hosting": "node scripts/audit-self-hosting.ts",
    "audit:self-hosting:gate": "node scripts/audit-self-hosting.ts --gate",
    "lint": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:features",
    "test:features": "node --test tests/all.test.ts",
    "test:features:verbose": "INOX_FEATURE_TEST_REPORT=verbose node --test tests/all.test.ts",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test:features && pnpm run audit:self-hosting:gate"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3"
  }
}
